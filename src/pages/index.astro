    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[#f3faf4]/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="text-center mb-16 reveal">
        <div class="inline-flex items-center gap-2 bg-[#dcfce7] rounded-full px-4 py-1.5 mb-6">
          <div class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></div>
