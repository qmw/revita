      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl overflow-hidden reveal">
        {cennik.map((item, i) => (
          <div
            class={`flex items-center justify-between px-8 py-5 hover:bg-white/5 transition-colors duration-200 group ${
              i < cennik.length - 1 ? "border-b border-white/10" : ""
            }`}
