                  <p class="text-white/90 text-xs leading-relaxed">{t.opis}</p>
                </div>
              </div>

              <!-- Info -->
              <div class="p-5">
                <div class="text-[#16a34a] text-xs font-bold uppercase tracking-wider mb-1" style="font-family: var(--font-display);">{t.spec}</div>
                <h3 class="font-bold text-[#14211a] text-sm leading-tight mb-2" style="font-family: var(--font-display);">{t.imie}</h3>
                <div class="flex items-center gap-1.5 text-xs text-[#14211a]/50">
