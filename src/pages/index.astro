---
import Layout from "../layouts/Layout.astro";

const U = "https://images.unsplash.com/";
const q = "?auto=format&fit=crop&q=80";
const img = {
  hero:  U + "photo-1571019613454-1cb2f99b2d8b" + q + "&w=1200",
  onas1: U + "photo-1559757175-0eb30cd8c063" + q + "&w=700",
  onas2: U + "photo-1598300042247-d088f8ab3a91" + q + "&w=700",
  t1:    U + "photo-1607990281513-2c110a25bd8c" + q + "&w=500",
  t2:    U + "photo-1612349317150-e413f6a5b16d" + q + "&w=500",
  t3:    U + "photo-1559839734-2b71ea197ec2" + q + "&w=500",
  t4:    U + "photo-1582750433449-648ed127bb54" + q + "&w=500",
};

const uslugi = [
  { nr: "01", name: "Fizjoterapia",           desc: "Kompleksowa ocena funkcjonalna i indywidualny plan terapii. Przywracamy sprawność po operacjach, urazach i schorzeniach narządu ruchu.",           price: "od 180 zł", bg: "bg-[#b6ff1a]",    tag: "Najpopularniejsza" },
  { nr: "02", name: "Terapia manualna",        desc: "Specjalistyczne techniki mobilizacji stawów i tkanek miękkich. Skuteczna w leczeniu bólu kręgosłupa, szyi i stawów obwodowych.",                  price: "od 200 zł", bg: "bg-[#ff6a00]",    tag: "" },
  { nr: "03", name: "Masaż leczniczy",         desc: "Profesjonalny masaż terapeutyczny redukujący napięcia mięśniowe, poprawiający krążenie i przyspieszający regenerację tkanek.",                    price: "od 130 zł", bg: "bg-[#ffffff]",    tag: "" },
  { nr: "04", name: "Rehab. po urazach",       desc: "Programy powrotu do aktywności po skręceniach, złamaniach i operacjach ortopedycznych. Pełna opieka od ostrego urazu do sportu.",                 price: "od 170 zł", bg: "bg-[#b6ff1a]",    tag: "Specjalność" },
  { nr: "05", name: "Fizykoterapia",           desc: "Zabiegi z użyciem ultradźwięków, laseroterapii, prądów TENS/EMS i magnetoterapii. Wspomagają gojenie i łagodzą ból.",                            price: "od 80 zł",  bg: "bg-[#15803d]",    tag: "" },
];

const terapeuci = [
  { imie: "mgr Katarzyna Wiśniewska", spec: "Fizjoterapia ortopedyczna",   doswiadczenie: "8 lat",  opis: "Specjalistka terapii manualnej. Certyfikowana terapeutka Mulligan i McKenzie.", img: img.t1, rot: "rot-2" },
  { imie: "mgr Paweł Kowalski",       spec: "Neurorehabilitacja",           doswiadczenie: "12 lat", opis: "Ekspert neurorehabilitacji i terapii po udarach. Prowadzi szkolenia z metody PNF.",  img: img.t2, rot: "rot-1" },
  { imie: "mgr Anna Zielińska",       spec: "Fizjoterapia sportowa",        doswiadczenie: "6 lat",  opis: "Fizjoterapeutka sportowa współpracująca z klubami piłkarskimi.",                    img: img.t3, rot: "rot-3" },
  { imie: "mgr Tomasz Nowak",         spec: "Terapia bólu kręgosłupa",     doswiadczenie: "9 lat",  opis: "Specjalista terapii punktów spustowych i terapii powięziowej.",                    img: img.t4, rot: "rot-2" },
];

const cennik = [
  ["Konsultacja fizjoterapeutyczna (60 min)", "180 zł"],
  ["Terapia manualna (60 min)",               "200 zł"],
  ["Masaż leczniczy (45 min)",                "130 zł"],
  ["Masaż leczniczy (60 min)",                "160 zł"],
  ["Rehabilitacja po urazach (60 min)",       "170 zł"],
  ["Fizykoterapia — pojedynczy zabieg",        "80 zł"],
  ["Fizykoterapia — pakiet 5 zabiegów",       "350 zł"],
  ["Pakiet rehabilitacyjny (10 wizyt)",      "1 500 zł"],
  ["Wizyta kontrolna (30 min)",               "100 zł"],
];

const godziny = [
  { dzien: "Pon – Pt", godz: "8:00 – 20:00", open: true  },
  { dzien: "Sobota",    godz: "9:00 – 15:00", open: true  },
  { dzien: "Niedziela", godz: "Zamknięte",     open: false },
];

const opinie = [
  { imie: "Marta K.",   ocena: 5, tekst: "Po kontuzji kolana myślałam, że nie wrócę do biegania. Po 8 sesjach z Katarzyną znowu startuję w zawodach!", usluga: "Rehabilitacja po urazach" },
  { imie: "Janusz W.",  ocena: 5, tekst: "Ból kręgosłupa towarzyszył mi przez 3 lata. Pan Tomasz w 5 wizyt zrobił to, czego nie osiągnął nikt wcześniej.",  usluga: "Terapia manualna"        },
  { imie: "Zuzanna P.", ocena: 5, tekst: "Gabinet cudowny — terapeuci naprawdę słuchają. Masaż leczniczy u Anny to absolutny must-have po ciężkim tygodniu.", usluga: "Masaż leczniczy"         },
];

const marquee = ["POWRÓT DO FORMY", "FIZJOTERAPIA", "TERAPIA MANUALNA", "MASAŻ LECZNICZY", "REHABILITACJA", "FIZYKOTERAPIA", "-50% RWY ✦"];
---

<Layout>

  <!-- ===== NAV ===== -->
  <nav id="nav" class="fixed inset-x-0 z-40 border-b-4 border-[#0a0a0a] bg-[#f3f3ee]">
    <div class="mx-auto flex max-w-[1440px] items-center justify-between px-4 py-3 lg:px-8">
      <a href="#top" class="disp inline-block bg-[#0a0a0a] px-4 py-2 text-2xl text-[#b6ff1a] nb-press" style="box-shadow:6px 6px 0 0 #b6ff1a;">RE<span class="text-[#ff6a00]">VITA</span></a>

      <div class="hidden items-center gap-1 lg:flex">
        {[["#o-nas","O nas"],["#uslugi","Usługi"],["#terapeuci","Terapeuci"],["#cennik","Cennik"]].map(([h,l]) => (
          <a href={h} class="mono nb2 nb-press bg-[#f3f3ee] px-3 py-2 text-xs font-bold uppercase tracking-widest hover:bg-[#b6ff1a] transition-colors">{l}</a>
        ))}
        <a href="#rezerwacja" class="disp nb nb-shadow bg-[#ff6a00] px-5 py-2 text-base text-white nb-press ml-2">UMÓW SIĘ →</a>
      </div>

      <button id="burger" class="nb2 bg-[#b6ff1a] px-3 py-2 lg:hidden" aria-label="Menu">
        <span class="mono text-xs font-bold uppercase">MENU</span>
      </button>
    </div>
    <div id="mobile-menu" class="hidden border-t-4 border-[#0a0a0a] bg-[#f3f3ee] px-4 py-4 lg:hidden">
      <div class="mono flex flex-col gap-2 text-sm font-bold uppercase">
        <a href="#o-nas"      class="nb2 px-3 py-2 hover:bg-[#b6ff1a]">O nas</a>
        <a href="#uslugi"     class="nb2 px-3 py-2 hover:bg-[#b6ff1a]">Usługi</a>
        <a href="#terapeuci"  class="nb2 px-3 py-2 hover:bg-[#b6ff1a]">Terapeuci</a>
        <a href="#cennik"     class="nb2 px-3 py-2 hover:bg-[#b6ff1a]">Cennik</a>
        <a href="#rezerwacja" class="nb nb-shadow bg-[#ff6a00] px-4 py-3 text-center text-white">Umów wizytę →</a>
      </div>
    </div>
  </nav>

  <style>
    #nav.scrolled { background: rgba(243,243,238,0.96); backdrop-filter: blur(8px); }
  </style>

  <!-- ===== HERO ===== -->
  <header id="top" class="relative overflow-hidden bg-[#0a0a0a] pt-28 pb-0 lg:pt-32">
    <!-- background image -->
    <div class="absolute inset-0 z-0">
      <img src={img.hero} alt="Fizjoterapia ReVita" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/60 via-[#0a0a0a]/30 to-[#0a0a0a]"></div>
    </div>

    <!-- dot grid pattern -->
    <div class="absolute inset-0 z-0 pointer-events-none" style="background-image:radial-gradient(rgba(182,255,26,.15) 1px,transparent 1px);background-size:32px 32px;"></div>

    <div class="relative z-10 mx-auto max-w-[1440px] px-4 lg:px-8">
      <!-- Top stickers row -->
      <div class="flex flex-wrap items-start gap-3 mb-8">
        <span class="mono nb2 nb-shadow-lime inline-block bg-[#b6ff1a] text-[#0a0a0a] px-3 py-1 text-xs font-bold uppercase rot-2 tracking-widest">★ Warszawa · Mokotów</span>
        <span class="mono nb2 nb-shadow-org inline-block bg-[#ff6a00] text-white px-3 py-1 text-xs font-bold uppercase rot-1 tracking-widest">↑ Od 2009</span>
        <span class="mono nb2 inline-block bg-white text-[#0a0a0a] px-3 py-1 text-xs font-bold uppercase rot-3 tracking-widest" style="box-shadow:8px 8px 0 0 #15803d;">4.9★ / 2400+ pacjentów</span>
      </div>

      <!-- Giant heading — asymmetric layout -->
      <div class="grid items-end gap-0 lg:grid-cols-[1fr_auto]">
        <div>
          <h1 class="disp text-[#f3f3ee]" style="font-size:clamp(5rem,13vw,12rem);line-height:.85;">
            <span class="block">WRÓĆ</span>
            <span class="block text-[#b6ff1a]">DO FORMY.</span>
            <span class="block stroke-lime" style="-webkit-text-stroke:3px #b6ff1a;">SZYBKO.</span>
          </h1>
          <p class="mt-6 max-w-xl text-[#f3f3ee]/70 text-lg leading-relaxed" style="font-family:var(--font-body);">
            ReVita to gabinet fizjoterapii i rehabilitacji, gdzie nowoczesne metody terapii spotykają się z indywidualnym podejściem. Twój ruch — nasza misja.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#rezerwacja" class="disp nb nb-shadow-lime bg-[#b6ff1a] px-8 py-4 text-xl text-[#0a0a0a] nb-press">UMÓW WIZYTĘ →</a>
            <a href="#uslugi"     class="disp nb2 nb-shadow bg-transparent border-[#f3f3ee] text-[#f3f3ee] px-8 py-4 text-xl nb-press hover:bg-[#f3f3ee] hover:text-[#0a0a0a] transition-colors">USŁUGI</a>
          </div>
        </div>

        <!-- Right side: vertical stats block -->
        <div class="hidden lg:flex flex-col gap-0 self-end pb-0">
          {[["2400+","pacjentów"],["15 lat","doświadczenia"],["98%","skuteczność"]].map(([v,l]) => (
            <div class="nb4 border-b-0 last:border-b-4 bg-[#b6ff1a] px-8 py-5 text-[#0a0a0a] min-w-[220px]">
              <div class="disp text-4xl">{v}</div>
              <div class="mono text-xs font-bold uppercase tracking-widest mt-1">{l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </header>

  <!-- ===== MARQUEE ===== -->
  <section class="border-y-4 border-[#0a0a0a] bg-[#ff6a00] py-3 overflow-hidden">
    <div class="flex whitespace-nowrap">
      <div class="marquee-track flex shrink-0">
        {[...marquee, ...marquee].map((w) => (
          <span class="disp mx-6 text-2xl text-white">{w} <span class="text-[#b6ff1a]">◆</span></span>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== O NAS ===== -->
  <section id="o-nas" class="bg-[#f3f3ee] px-4 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <!-- label -->
      <div class="mb-6">
        <span class="mono nb2 nb-shadow-lime inline-block bg-[#b6ff1a] px-3 py-1 text-xs font-bold uppercase tracking-widest rot-2">// O nas</span>
      </div>

      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] items-start">
        <!-- Left: photo stack -->
        <div class="reveal-l relative">
          <!-- Big frame -->
          <div class="nb nb-shadow-lg overflow-hidden bg-[#0a0a0a] rot-2">
            <img src={img.onas1} alt="Gabinet ReVita" class="aspect-[4/5] w-full object-cover grayscale contrast-110" />
          </div>
          <!-- Overlapping sticker: 15+ lat -->
          <div class="disp absolute -bottom-6 -right-4 nb nb-shadow bg-[#ff6a00] px-6 py-4 text-white rot-1" style="box-shadow:8px 8px 0 0 #0a0a0a;">
            <span class="block text-5xl leading-none">15+</span>
            <span class="mono block text-xs font-bold uppercase mt-1">Lat doświadczenia</span>
          </div>
          <!-- Small floating photo -->
          <div class="absolute -top-5 -left-6 nb nb-shadow-lime overflow-hidden w-36 h-44 rot-1 hidden lg:block">
            <img src={img.onas2} alt="Terapia" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Right: text -->
        <div class="reveal-r">
          <h2 class="disp text-[#0a0a0a]" style="font-size:clamp(3.5rem,7vw,7rem);line-height:.88;">
            TWOJE<br />
            ZDROWIE<br />
            <span class="text-[#15803d]">NASZA</span><br />
            <span class="stroke-ink">MISJA.</span>
          </h2>
          <p class="mt-6 text-[#0a0a0a]/75 text-base leading-relaxed max-w-lg">
            ReVita powstała z pasji do ruchu i przekonania, że każdy człowiek zasługuje na życie bez bólu i ograniczeń. Od 2009 roku pomagamy pacjentom w Warszawie odzyskać sprawność i powrócić do aktywnego życia.
          </p>
          <p class="mt-4 text-[#0a0a0a]/60 text-sm leading-relaxed max-w-lg">
            Nasz gabinet przy ul. Puławskiej łączy najnowsze metody fizjoterapeutyczne z indywidualnym podejściem do każdego pacjenta. Skuteczna rehabilitacja to zrozumienie źródła problemu — nie tylko leczenie objawów.
          </p>

          <!-- Feature tags -->
          <div class="mt-8 flex flex-wrap gap-3">
            {["Diagnoza funkcjonalna","Indywidualny plan terapii","Sprzęt najnowszej generacji","Podejście holistyczne"].map((f) => (
              <span class="mono nb2 bg-[#muted] px-3 py-1 text-xs font-bold uppercase tracking-wide bg-[#e8e8e3]">{f}</span>
            ))}
          </div>

          <a href="#rezerwacja" class="disp mt-8 inline-block nb nb-shadow bg-[#0a0a0a] text-[#b6ff1a] px-7 py-3 text-lg nb-press">POZNAJ NAS →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== USŁUGI ===== -->
  <section id="uslugi" class="border-t-4 border-[#0a0a0a] bg-[#0a0a0a] px-4 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <!-- header row -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between mb-12 gap-4">
        <h2 class="disp text-[#f3f3ee]" style="font-size:clamp(3rem,8vw,8rem);line-height:.85;">
          NASZE<br /><span class="text-[#b6ff1a]">USŁUGI.</span>
        </h2>
        <p class="mono text-[#f3f3ee]/50 text-sm max-w-xs font-bold uppercase tracking-wide">
          Od ostrego urazu po przewlekły ból — dobieramy metody dostosowane do Twoich celów.
        </p>
      </div>

      <!-- Services grid — intentional asymmetry -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {uslugi.map((u, i) => (
          <div class={`reveal nb nb-shadow nb-press ${u.bg} p-7 relative ${i === 1 ? "rot-1 sm:mt-6" : i === 3 ? "rot-2" : ""} ${u.bg === "bg-[#15803d]" ? "text-white" : "text-[#0a0a0a]"}`}>
            {u.tag && (
              <div class="mono absolute -top-3 -right-2 nb2 bg-[#ff6a00] text-white px-3 py-1 text-xs font-bold uppercase rot-4" style="box-shadow:4px 4px 0 0 #0a0a0a;">
                {u.tag}
              </div>
            )}
            <div class="flex items-start justify-between mb-4">
              <span class="disp text-5xl opacity-30">{u.nr}</span>
              <span class="mono nb2 bg-[#0a0a0a] text-[#b6ff1a] px-3 py-1 text-sm font-bold">{u.price}</span>
            </div>
            <h3 class="disp text-3xl mb-3">{u.name}</h3>
            <p class="text-sm leading-relaxed opacity-80 max-w-xs">{u.desc}</p>
            <a href="#rezerwacja" class={`mono mt-5 inline-block nb2 px-4 py-2 text-xs font-bold uppercase tracking-wide hover:bg-[#b6ff1a] hover:text-[#0a0a0a] hover:border-[#0a0a0a] transition-colors ${u.bg === "bg-[#15803d]" ? "border-white text-white" : "border-[#0a0a0a]"}`}>Umów →</a>
          </div>
        ))}

        <!-- CTA card -->
        <div class="reveal nb nb-shadow-lime bg-[#b6ff1a] p-7 flex flex-col justify-between rot-1">
          <div>
            <span class="disp text-5xl block text-[#0a0a0a]/20">?</span>
            <h3 class="disp text-3xl mt-2 text-[#0a0a0a]">NIE WIESZ<br />CO WYBRAĆ?</h3>
            <p class="mt-3 text-sm text-[#0a0a0a]/70 leading-relaxed max-w-xs">
              Umów bezpłatną konsultację wstępną — pomożemy dobrać odpowiednią terapię do Twoich potrzeb.
            </p>
          </div>
          <a href="#rezerwacja" class="disp mt-6 inline-block nb nb-shadow bg-[#0a0a0a] text-[#b6ff1a] px-6 py-3 text-base nb-press">BEZPŁATNA KONSULTACJA →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MARQUEE 2 — lime ===== -->
  <section class="border-y-4 border-[#0a0a0a] bg-[#b6ff1a] py-3 overflow-hidden">
    <div class="flex whitespace-nowrap">
      <div class="marquee-track flex shrink-0" style="animation-direction:reverse;">
        {["EFEKTYWNA TERAPIA","CERTYFIKOWANI TERAPEUCI","SPRZĘT NAJWYŻSZEJ KLASY","INDYWIDUALNY PLAN","WARSZAWA MOKOTÓW","REZERWUJ ONLINE"].map((w) => (
          <span class="disp mx-6 text-xl text-[#0a0a0a]">{w} <span class="text-[#15803d]">✦</span></span>
        ))}
        {["EFEKTYWNA TERAPIA","CERTYFIKOWANI TERAPEUCI","SPRZĘT NAJWYŻSZEJ KLASY","INDYWIDUALNY PLAN","WARSZAWA MOKOTÓW","REZERWUJ ONLINE"].map((w) => (
          <span class="disp mx-6 text-xl text-[#0a0a0a]">{w} <span class="text-[#15803d]">✦</span></span>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TERAPEUCI ===== -->
  <section id="terapeuci" class="bg-[#f3f3ee] px-4 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <div class="mb-10">
        <span class="mono nb2 nb-shadow-org inline-block bg-[#ff6a00] text-white px-3 py-1 text-xs font-bold uppercase tracking-widest rot-1">// Nasz zespół</span>
        <h2 class="disp mt-4 text-[#0a0a0a]" style="font-size:clamp(3rem,7vw,7rem);line-height:.88;">
          POZNAJ<br /><span class="text-[#15803d]">TERAPEUTÓW.</span>
        </h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {terapeuci.map((t, i) => (
          <figure class={`reveal nb nb-shadow overflow-hidden bg-[#0a0a0a] ${t.rot} group`}>
            <div class="overflow-hidden">
              <img
                src={t.img} alt={t.imie} loading="lazy"
                class="aspect-[3/4] w-full object-cover object-top grayscale contrast-110 transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105"
              />
            </div>
            <figcaption class={`border-t-3 border-[#0a0a0a] px-4 py-4 ${i % 2 === 0 ? "bg-[#b6ff1a] text-[#0a0a0a]" : "bg-[#ff6a00] text-white"}`}>
              <p class="disp text-xl leading-tight">{t.imie}</p>
              <p class="mono mt-1 text-xs font-bold uppercase tracking-wide opacity-80">{t.spec}</p>
              <p class="mono mt-1 text-xs font-bold opacity-60">{t.doswiadczenie} doświadczenia</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <!-- Opinions strip -->
      <div class="mt-20 grid gap-6 md:grid-cols-3">
        {opinie.map((o, i) => (
          <div class={`reveal nb nb-shadow bg-white p-7 relative ${i === 1 ? "rot-2 md:mt-8" : i === 2 ? "rot-1" : ""}`}>
            <div class="flex gap-1 mb-4">
              {Array.from({length: o.ocena}).map(() => (
                <span class="text-[#b6ff1a] text-lg">★</span>
              ))}
            </div>
            <p class="text-[#0a0a0a]/80 text-sm leading-relaxed mb-5">„{o.tekst}"</p>
            <div class="border-t-2 border-[#0a0a0a] pt-4 flex items-center justify-between">
              <span class="disp text-lg text-[#0a0a0a]">{o.imie}</span>
              <span class="mono text-xs font-bold text-[#15803d] uppercase">{o.usluga}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CENNIK ===== -->
  <section id="cennik" class="border-t-4 border-[#0a0a0a] bg-[#15803d] px-4 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] items-start">
        <!-- Left: header + info -->
        <div>
          <span class="mono nb2 inline-block bg-[#b6ff1a] text-[#0a0a0a] px-3 py-1 text-xs font-bold uppercase tracking-widest rot-2">// Cennik</span>
          <h2 class="disp mt-4 text-white" style="font-size:clamp(3rem,7vw,7rem);line-height:.88;">
            PRZEJRZYSTE<br />CENY<br /><span class="text-[#b6ff1a]">BEZ NIESPODZIANEK.</span>
          </h2>
          <p class="mono mt-6 text-white/70 text-sm font-bold uppercase tracking-wide max-w-xs">
            Płatność gotówką i kartą. Możliwość wystawienia faktury VAT. Pakiety z rabatem do 15%.
          </p>
          <a href="#rezerwacja" class="disp mt-8 inline-block nb nb-shadow-lime bg-[#b6ff1a] text-[#0a0a0a] px-7 py-3 text-xl nb-press">ZAREZERWUJ WIZYTĘ →</a>
        </div>

        <!-- Right: price list as raw receipt -->
        <div class="reveal nb nb-shadow-lg bg-[#f3f3ee] p-6 lg:p-8 rot-3">
          <div class="flex items-center justify-between border-b-[3px] border-dashed border-[#0a0a0a] pb-4 mb-5">
            <span class="disp text-2xl">CENNIK</span>
            <span class="mono text-xs font-bold uppercase">// gotówka / karta</span>
          </div>
          <ul class="space-y-3">
            {cennik.map(([n, p]) => (
              <li class="mono flex items-end gap-2 text-sm font-bold">
                <span class="uppercase leading-tight">{n}</span>
                <span class="mb-0.5 flex-1 border-b-2 border-dotted border-[#0a0a0a] min-w-[16px]"></span>
                <span class="bg-[#b6ff1a] px-2 py-0.5 shrink-0">{p}</span>
              </li>
            ))}
          </ul>
          <p class="mono mt-6 text-center text-xs uppercase border-t-2 border-dashed border-[#0a0a0a] pt-4 text-[#0a0a0a]/60">— dziękujemy za zaufanie —</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== REZERWACJA + KONTAKT + MAPA ===== -->
  <section id="rezerwacja" class="border-t-4 border-[#0a0a0a] bg-[#f3f3ee] px-4 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <!-- Section label -->
      <div class="mb-8 flex flex-wrap items-end gap-6">
        <h2 class="disp text-[#0a0a0a]" style="font-size:clamp(3rem,7vw,7rem);line-height:.88;">
          UMÓW<br /><span class="text-[#ff6a00]">WIZYTĘ.</span>
        </h2>
        <span class="mono nb2 nb-shadow-org inline-block bg-[#ff6a00] text-white px-4 py-2 text-xs font-bold uppercase tracking-widest rot-2 self-start mt-4">Odpiszemy do 24h</span>
      </div>

      <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr]">
        <!-- Form -->
        <div class="reveal-l nb nb-shadow-lg bg-white p-7 lg:p-10">
          <form id="booking-form" class="grid gap-5">
            <div class="grid sm:grid-cols-2 gap-5">
              <label class="mono text-xs font-bold uppercase tracking-wide">
                Imię i nazwisko *
                <input type="text" required placeholder="Jan Kowalski"
                  class="nb2 mt-1 w-full bg-[#f3f3ee] px-3 py-2 font-body text-base outline-none focus:bg-[#b6ff1a] transition-colors" />
              </label>
              <label class="mono text-xs font-bold uppercase tracking-wide">
                Telefon *
                <input type="tel" required placeholder="+48 600 123 456"
                  class="nb2 mt-1 w-full bg-[#f3f3ee] px-3 py-2 font-body text-base outline-none focus:bg-[#b6ff1a] transition-colors" />
              </label>
            </div>
            <label class="mono text-xs font-bold uppercase tracking-wide">
              Adres e-mail *
              <input type="email" required placeholder="jan@email.pl"
                class="nb2 mt-1 w-full bg-[#f3f3ee] px-3 py-2 font-body text-base outline-none focus:bg-[#b6ff1a] transition-colors" />
            </label>
            <div class="grid sm:grid-cols-2 gap-5">
              <label class="mono text-xs font-bold uppercase tracking-wide">
                Rodzaj usługi
                <select class="nb2 mt-1 w-full bg-[#f3f3ee] px-3 py-2 font-body text-base outline-none focus:bg-[#b6ff1a] transition-colors">
                  <option value="">Wybierz usługę</option>
                  <option>Fizjoterapia</option>
                  <option>Terapia manualna</option>
                  <option>Masaż leczniczy</option>
                  <option>Rehabilitacja po urazach</option>
                  <option>Fizykoterapia</option>
                  <option>Bezpłatna konsultacja</option>
                </select>
              </label>
              <label class="mono text-xs font-bold uppercase tracking-wide">
                Preferowany termin
                <input type="date"
                  class="nb2 mt-1 w-full bg-[#f3f3ee] px-3 py-2 font-body text-base outline-none focus:bg-[#b6ff1a] transition-colors" />
              </label>
            </div>
            <label class="mono text-xs font-bold uppercase tracking-wide">
              Opisz swój problem (opcjonalnie)
              <textarea rows="4" placeholder="Opisz dolegliwości lub cel wizyty..."
                class="nb2 mt-1 w-full bg-[#f3f3ee] px-3 py-2 font-body text-base outline-none focus:bg-[#b6ff1a] transition-colors resize-none"></textarea>
            </label>
            <button type="submit" class="disp nb nb-shadow bg-[#ff6a00] text-white px-6 py-4 text-xl nb-press w-full text-center">WYŚLIJ REZERWACJĘ →</button>
            <p class="mono text-xs text-[#0a0a0a]/40 text-center uppercase">* Skontaktujemy się w ciągu 24h, by potwierdzić termin.</p>
          </form>
        </div>

        <!-- Contact + hours + map -->
        <div class="reveal-r flex flex-col gap-5">
          <!-- Godziny -->
          <div class="nb nb-shadow bg-[#0a0a0a] p-6">
            <span class="mono text-[#b6ff1a] text-xs font-bold uppercase tracking-widest block mb-4">// Godziny otwarcia</span>
            <div class="space-y-3">
              {godziny.map((g) => (
                <div class="mono flex items-center justify-between text-sm font-bold">
                  <span class="text-white/70 uppercase">{g.dzien}</span>
                  <span class={g.open ? "bg-[#b6ff1a] text-[#0a0a0a] px-2 py-0.5" : "text-red-400"}>{g.godz}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Kontakt -->
          <div class="nb nb-shadow bg-white p-6">
            <span class="mono text-[#0a0a0a]/50 text-xs font-bold uppercase tracking-widest block mb-4">// Kontakt</span>
            <div class="space-y-3">
              <a href="tel:+48221234567" class="mono flex items-center gap-3 text-sm font-bold text-[#0a0a0a] hover:text-[#15803d] transition-colors group">
                <span class="nb2 bg-[#b6ff1a] px-2 py-1 text-[#0a0a0a] group-hover:bg-[#15803d] group-hover:text-white transition-colors">TEL</span>
                +48 22 123 45 67
              </a>
              <a href="mailto:kontakt@revita.pl" class="mono flex items-center gap-3 text-sm font-bold text-[#0a0a0a] hover:text-[#15803d] transition-colors group">
                <span class="nb2 bg-[#b6ff1a] px-2 py-1 text-[#0a0a0a] group-hover:bg-[#15803d] group-hover:text-white transition-colors">EMAIL</span>
                kontakt@revita.pl
              </a>
              <div class="mono flex items-start gap-3 text-sm font-bold text-[#0a0a0a]">
                <span class="nb2 bg-[#b6ff1a] px-2 py-1 shrink-0">ADR</span>
                ul. Puławska 42, 02-512 Warszawa
              </div>
            </div>
          </div>

          <!-- Mapa OSM -->
          <div class="nb nb-shadow overflow-hidden flex-1 min-h-[200px]">
            <iframe
              src="https://www.openstreetmap.org/export/embed.html?bbox=21.00%2C52.18%2C21.04%2C52.22&layer=mapnik&marker=52.200%2C21.020"
              width="100%" height="240"
              style="border:0;display:block;"
              loading="lazy"
              title="Mapa dojazdu do ReVita"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="border-t-4 border-[#0a0a0a] bg-[#0a0a0a] px-4 py-14 lg:px-8 text-[#f3f3ee]">
    <div class="mx-auto max-w-[1440px]">
      <div class="grid gap-10 md:grid-cols-[1fr_auto_auto] items-start">
        <!-- Brand -->
        <div>
          <a href="#top" class="disp inline-block bg-[#b6ff1a] text-[#0a0a0a] px-5 py-3 text-4xl nb-press nb nb-shadow-lime">REVITA</a>
          <p class="mt-4 text-[#f3f3ee]/50 text-sm max-w-sm leading-relaxed">
            Gabinet fizjoterapii i rehabilitacji w Warszawie. Przywracamy sprawność i jakość życia od 2009 roku.
          </p>
          <div class="mono mt-4 flex gap-3">
            {["FB","IG","LN"].map((s) => (
              <a href="#" class="nb2 border-[#f3f3ee]/30 text-[#f3f3ee]/50 hover:bg-[#b6ff1a] hover:text-[#0a0a0a] hover:border-[#b6ff1a] px-3 py-2 text-xs font-bold transition-colors">{s}</a>
            ))}
          </div>
        </div>

        <!-- Usługi links -->
        <div>
          <span class="mono text-[#b6ff1a] text-xs font-bold uppercase tracking-widest block mb-4">Usługi</span>
          <ul class="space-y-2">
            {["Fizjoterapia","Terapia manualna","Masaż leczniczy","Rehabilitacja","Fizykoterapia"].map((item) => (
              <li><a href="#uslugi" class="mono text-[#f3f3ee]/50 hover:text-[#b6ff1a] text-sm font-bold uppercase transition-colors">{item}</a></li>
            ))}
          </ul>
        </div>

        <!-- Kontakt dane -->
        <div>
          <span class="mono text-[#b6ff1a] text-xs font-bold uppercase tracking-widest block mb-4">Kontakt</span>
          <ul class="space-y-2 mono text-[#f3f3ee]/50 text-sm font-bold uppercase">
            <li>ul. Puławska 42</li>
            <li>02-512 Warszawa</li>
            <li class="mt-3"><a href="tel:+48221234567" class="hover:text-[#b6ff1a] transition-colors">+48 22 123 45 67</a></li>
            <li><a href="mailto:kontakt@revita.pl" class="hover:text-[#b6ff1a] transition-colors">kontakt@revita.pl</a></li>
          </ul>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="mt-12 border-t border-[#f3f3ee]/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="mono text-[#f3f3ee]/30 text-xs uppercase">&copy; {new Date().getFullYear()} ReVita. Wszelkie prawa zastrzeżone.</p>
        <p class="mono text-[#f3f3ee]/30 text-xs uppercase text-center">
          Przykładowa strona zrobiona przez{" "}
          <a href="https://100strona.pl" target="_blank" rel="noopener"
             class="bg-[#b6ff1a] text-[#0a0a0a] px-1 font-bold hover:bg-white transition-colors">
            3P sp. z o.o.
          </a>
        </p>
      </div>
    </div>
  </footer>

</Layout>
