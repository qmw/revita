  <!-- ═══════════════════════════════════════════════
       REZERWACJA + KONTAKT + MAPA
  ══════════════════════════════════════════════════ -->
  <section id="rezerwacja" class="py-24 md:py-32 bg-[#f3faf4] relative overflow-hidden">
    <div class="absolute top-0 left-0 w-80 h-80 bg-[#dcfce7] rounded-full blur-3xl opacity-60 pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-64 h-64 bg-[#a3e635]/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="text-center mb-16 reveal">
        <div class="inline-flex items-center gap-2 bg-white rounded-full px-4 py-1.5 mb-6 shadow-sm">
          <div class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></div>
          <span class="text-[#14532d] text-xs font-bold tracking-widest uppercase" style="font-family: var(--font-display);">Rezerwacja</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-extrabold text-[#14211a] leading-tight" style="font-family: var(--font-display);">
          Umów wizytę<br/>
          <span class="text-[#16a34a]">już dziś</span>
        </h2>
      </div>

      <div class="grid lg:grid-cols-5 gap-10">
        <!-- Form — 3 cols -->
        <div class="lg:col-span-3 reveal-left">
          <div class="bg-white rounded-3xl p-8 shadow-sm">
            <h3 class="text-xl font-bold text-[#14211a] mb-6" style="font-family: var(--font-display);">Formularz rezerwacji</h3>
            <form class="space-y-5" id="contact-form">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-semibold text-[#14211a]/70 mb-2" style="font-family: var(--font-display);">Imię i nazwisko *</label>
                  <input
                    type="text"
                    placeholder="Jan Kowalski"
                    class="w-full px-4 py-3 rounded-xl border border-[#dcfce7] bg-[#f3faf4] text-[#14211a] placeholder-[#14211a]/30 focus:outline-none focus:border-[#16a34a] focus:ring-2 focus:ring-[#16a34a]/20 transition-all duration-200"
                    required
                  />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-[#14211a]/70 mb-2" style="font-family: var(--font-display);">Telefon *</label>
                  <input
                    type="tel"
                    placeholder="+48 600 123 456"
                    class="w-full px-4 py-3 rounded-xl border border-[#dcfce7] bg-[#f3faf4] text-[#14211a] placeholder-[#14211a]/30 focus:outline-none focus:border-[#16a34a] focus:ring-2 focus:ring-[#16a34a]/20 transition-all duration-200"
                    required
                  />
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold text-[#14211a]/70 mb-2" style="font-family: var(--font-display);">Adres e-mail *</label>
                <input
                  type="email"
                  placeholder="jan@email.pl"
                  class="w-full px-4 py-3 rounded-xl border border-[#dcfce7] bg-[#f3faf4] text-[#14211a] placeholder-[#14211a]/30 focus:outline-none focus:border-[#16a34a] focus:ring-2 focus:ring-[#16a34a]/20 transition-all duration-200"
                  required
                />
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-semibold text-[#14211a]/70 mb-2" style="font-family: var(--font-display);">Rodzaj usługi</label>
                  <select class="w-full px-4 py-3 rounded-xl border border-[#dcfce7] bg-[#f3faf4] text-[#14211a] focus:outline-none focus:border-[#16a34a] focus:ring-2 focus:ring-[#16a34a]/20 transition-all duration-200">
                    <option value="">Wybierz usługę</option>
                    <option>Fizjoterapia</option>
                    <option>Terapia manualna</option>
                    <option>Masaż leczniczy</option>
                    <option>Rehabilitacja po urazach</option>
                    <option>Fizykoterapia</option>
                    <option>Bezpłatna konsultacja</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-[#14211a]/70 mb-2" style="font-family: var(--font-display);">Preferowany termin</label>
                  <input
                    type="date"
                    class="w-full px-4 py-3 rounded-xl border border-[#dcfce7] bg-[#f3faf4] text-[#14211a] focus:outline-none focus:border-[#16a34a] focus:ring-2 focus:ring-[#16a34a]/20 transition-all duration-200"
                  />
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold text-[#14211a]/70 mb-2" style="font-family: var(--font-display);">Opisz swój problem (opcjonalnie)</label>
                <textarea
                  rows="4"
                  placeholder="Opisz dolegliwości, które Cię niepokoją lub cel wizyty..."
                  class="w-full px-4 py-3 rounded-xl border border-[#dcfce7] bg-[#f3faf4] text-[#14211a] placeholder-[#14211a]/30 focus:outline-none focus:border-[#16a34a] focus:ring-2 focus:ring-[#16a34a]/20 transition-all duration-200 resize-none"
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full bg-[#16a34a] hover:bg-[#14532d] text-white font-bold py-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 text-base shadow-lg shadow-green-900/20"
                style="font-family: var(--font-display);"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Wyślij rezerwację
              </button>
              <p class="text-[#14211a]/40 text-xs text-center">* Skontaktujemy się w ciągu 24h, by potwierdzić termin.</p>
            </form>
          </div>
        </div>

        <!-- Contact info + hours — 2 cols -->
        <div class="lg:col-span-2 reveal-right flex flex-col gap-6">
          <!-- Hours -->
          <div class="bg-white rounded-3xl p-6 shadow-sm">
            <h3 class="text-base font-bold text-[#14211a] mb-4 flex items-center gap-2" style="font-family: var(--font-display);">
              <svg class="w-5 h-5 text-[#16a34a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Godziny otwarcia
            </h3>
            <div class="space-y-3">
              {godziny.map((g) => (
                <div class="flex justify-between items-center py-2 border-b border-[#f3faf4] last:border-0">
                  <span class="text-sm text-[#14211a]/70 font-medium">{g.dzien}</span>
                  <span class={`text-sm font-bold ${g.godz === "Zamknięte" ? "text-red-400" : "text-[#16a34a]"}`} style="font-family: var(--font-display);">{g.godz}</span>
                </div>
              ))}
            </div>
