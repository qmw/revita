        <!-- CTA card -->
        <div class="reveal reveal-delay-3 bg-[#14532d] rounded-3xl p-8 flex flex-col justify-between relative overflow-hidden md:col-span-2 lg:col-span-1">
          <div class="absolute top-0 right-0 w-48 h-48 bg-[#16a34a]/20 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"></div>
          <div>
            <div class="w-14 h-14 bg-[#a3e635] rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-[#14532d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3" style="font-family: var(--font-display);">Nie wiesz co wybrać?</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-8">Umów bezpłatną konsultację wstępną — pomożemy dobrać odpowiednią terapię do Twoich potrzeb.</p>
          </div>
          <a
            href="#rezerwacja"
            class="inline-flex items-center justify-center gap-2 bg-[#a3e635] hover:bg-white text-[#14532d] font-bold py-3 px-6 rounded-full transition-all duration-300"
