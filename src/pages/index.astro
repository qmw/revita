---
import Layout from "../layouts/Layout.astro";

const nav_links = [
  { href: "#o-nas", label: "O nas" },
  { href: "#uslugi", label: "Usługi" },
  { href: "#terapeuci", label: "Terapeuci" },
  { href: "#cennik", label: "Cennik" },
  { href: "#rezerwacja", label: "Rezerwacja" },
];

const uslugi = [
  {
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10"><path d="M20 4C11.163 4 4 11.163 4 20s7.163 16 16 16 16-7.163 16-16S28.837 4 20 4zm0 4a4 4 0 110 8 4 4 0 010-8zm0 22c-4 0-7.56-2.04-9.68-5.14C10.36 22.2 16 20.4 20 20.4c4 0 9.64 1.8 9.68 4.46C27.56 27.96 24 30 20 30z" fill="currentColor"/>`,
    name: "Fizjoterapia",
    desc: "Kompleksowa ocena funkcjonalna i indywidualny plan terapii. Przywracamy sprawność po operacjach, urazach i schorzeniach narządu ruchu.",
    price: "od 180 zł",
    tag: "Najpopularniejsza",
  },
  {
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10"><path d="M8 20c0-6.627 5.373-12 12-12s12 5.373 12 12-5.373 12-12 12S8 26.627 8 20zm12-8a8 8 0 100 16A8 8 0 0020 12zm-1 4h2v5.586l3.707 3.707-1.414 1.414L19 23.414V16z" fill="currentColor"/>`,
    name: "Terapia manualna",
    desc: "Specjalistyczne techniki mobilizacji stawów i tkanek miękkich. Skuteczna w leczeniu bólu kręgosłupa, szyi i stawów obwodowych.",
    price: "od 200 zł",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10"><path d="M14 8h12a2 2 0 012 2v4H12v-4a2 2 0 012-2zM10 16h20l-2 14H12L10 16zm8 4v6h4v-6h-4z" fill="currentColor"/>`,
    name: "Masaż leczniczy",
    desc: "Profesjonalny masaż terapeutyczny redukujący napięcia mięśniowe, poprawiający krążenie i przyspieszający regenerację tkanek.",
    price: "od 130 zł",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10"><path d="M20 6l3.09 9.51H33l-8.09 5.88 3.09 9.51L20 25.02l-8 5.88 3.09-9.51L7 15.51h9.91z" fill="currentColor"/>`,
    name: "Rehabilitacja po urazach",
    desc: "Programy powrotu do aktywności po skręceniach, złamaniach i operacjach ortopedycznych. Pełna opieka od ostrego urazu do sportu.",
    price: "od 170 zł",
    tag: "Specjalność",
  },
  {
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10"><path d="M12 10h16v4H12zm-2 6h20l2 2v12H8V18l2-2zm4 4v8h12v-8H14zm3 2h6v4h-6v-4z" fill="currentColor"/>`,
    name: "Fizykoterapia",
    desc: "Zabiegi z użyciem ultradźwięków, laseroterapii, prądów TENS/EMS i magnetoterapii. Wspomagają gojenie i łagodzą ból.",
    price: "od 80 zł",
    tag: "",
  },
];

const terapeuci = [
  {
    imie: "mgr Katarzyna Wiśniewska",
    spec: "Fizjoterapia ortopedyczna",
    doswiadczenie: "8 lat doświadczenia",
    opis: "Specjalistka terapii manualnej i rehabilitacji ortopedycznej. Absolwentka AWF Warszawa, certyfikowana terapeutka Mulligan i McKenzie.",
    foto: "photo-1607990281513-2c110a25bd8c",
    initials: "KW",
  },
  {
    imie: "mgr Paweł Kowalski",
    spec: "Neurorehabilitacja",
    doswiadczenie: "12 lat doświadczenia",
    opis: "Ekspert w zakresie neurorehabilitacji i terapii po udarach. Prowadzi szkolenia z metody PNF dla fizjoterapeutów w całej Polsce.",
    foto: "photo-1612349317150-e413f6a5b16d",
    initials: "PK",
  },
  {
    imie: "mgr Anna Zielińska",
    spec: "Fizjoterapia sportowa",
    doswiadczenie: "6 lat doświadczenia",
    opis: "Fizjoterapeutka sportowa współpracująca z klubami piłkarskimi. Specjalizuje się w prewencji urazów i powrocie sportowców do gry.",
    foto: "photo-1559839734-2b71ea197ec2",
    initials: "AZ",
  },
  {
    imie: "mgr Tomasz Nowak",
    spec: "Terapia bólu kręgosłupa",
    doswiadczenie: "9 lat doświadczenia",
    opis: "Specjalista terapii punktów spustowych i terapii powięziowej. Autor kursów z diagnostyki i leczenia dysfunkcji kręgosłupa.",
    foto: "photo-1582750433449-648ed127bb54",
    initials: "TN",
  },
];

const cennik = [
  { usluga: "Konsultacja fizjoterapeutyczna (60 min)", cena: "180 zł" },
  { usluga: "Terapia manualna (60 min)", cena: "200 zł" },
  { usluga: "Masaż leczniczy (45 min)", cena: "130 zł" },
  { usluga: "Masaż leczniczy (60 min)", cena: "160 zł" },
  { usluga: "Rehabilitacja po urazach (60 min)", cena: "170 zł" },
  { usluga: "Fizykoterapia — pojedynczy zabieg", cena: "80 zł" },
  { usluga: "Fizykoterapia — pakiet 5 zabiegów", cena: "350 zł" },
  { usluga: "Pakiet rehabilitacyjny (10 wizyt)", cena: "1 500 zł" },
  { usluga: "Wizyta kontrolna (30 min)", cena: "100 zł" },
];

const godziny = [
  { dzien: "Poniedziałek – Piątek", godz: "8:00 – 20:00" },
  { dzien: "Sobota", godz: "9:00 – 15:00" },
  { dzien: "Niedziela", godz: "Zamknięte" },
];

const stats = [
  { value: 2400, suffix: "+", label: "Zadowolonych pacjentów" },
  { value: 15, suffix: " lat", label: "Na rynku" },
  { value: 4, suffix: "", label: "Specjalistów" },
  { value: 98, suffix: "%", label: "Skuteczność terapii" },
];

const opinie = [
  {
    imie: "Marta K.",
    ocena: 5,
    tekst: "Po kontuzji kolana myślałam, że nie wrócę do biegania. Po 8 sesjach z Katarzyną znowu startuję w zawodach. Polecam z całego serca!",
    usluga: "Rehabilitacja po urazach",
  },
  {
    imie: "Janusz W.",
    ocena: 5,
    tekst: "Ból kręgosłupa towarzyszył mi przez 3 lata. Pan Tomasz w 5 wizyt zrobił to, czego nie osiągnął nikt wcześniej. Profesjonalizm na najwyższym poziomie.",
    usluga: "Terapia manualna",
  },
  {
    imie: "Zuzanna P.",
    ocena: 5,
    tekst: "Gabinet jest cudowny — czysty, spokojny, a terapeuci naprawdę słuchają. Masaż leczniczy u Anny to absolutny must-have po długim tygodniu pracy.",
    usluga: "Masaż leczniczy",
  },
];
---

<Layout>
  <!-- ═══════════════════════════════════════════════
       NAVIGATION — fixed, SPEC trap #2 handled
  ══════════════════════════════════════════════════ -->
  <nav
    id="nav"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
    style="font-family: var(--font-display);"
  >
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-[#16a34a] flex items-center justify-center group-hover:bg-[#a3e635] transition-colors duration-300">
          <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-white group-hover:text-[#14532d] transition-colors duration-300">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" fill="currentColor"/>
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" stroke="currentColor" stroke-width="0" fill="none"/>
          </svg>
        </div>
        <span class="text-xl font-bold text-white tracking-tight">
          Re<span class="text-[#a3e635]">Vita</span>
        </span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-8">
        {nav_links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-semibold text-white/80 hover:text-[#a3e635] transition-colors duration-200 relative group"
            >
              {link.label}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#a3e635] group-hover:w-full transition-all duration-300"></span>
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA + Burger -->
      <div class="flex items-center gap-4">
        <a
          href="#rezerwacja"
          class="hidden md:inline-flex items-center gap-2 bg-[#16a34a] hover:bg-[#a3e635] text-white hover:text-[#14532d] font-bold text-sm px-5 py-2.5 rounded-full transition-all duration-300 shadow-lg shadow-green-900/20"
        >
          Umów wizytę
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

        <button
          id="burger"
          class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 text-white"
          aria-label="Menu"
        >
          <span class="w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
          <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
          <span class="w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-white/10"
      style="background: rgba(20, 83, 45, 0.97); backdrop-filter: blur(12px);"
    >
      <ul class="flex flex-col px-6 py-4 gap-4">
        {nav_links.map((link) => (
          <li>
            <a href={link.href} class="text-white/90 hover:text-[#a3e635] font-semibold text-base transition-colors duration-200 block py-1">
              {link.label}
            </a>
          </li>
        ))}
        <li class="pt-2">
          <a href="#rezerwacja" class="block text-center bg-[#16a34a] text-white font-bold py-3 rounded-full hover:bg-[#a3e635] hover:text-[#14532d] transition-all duration-300">
            Umów wizytę
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- SPEC trap #2: scrolled nav style -->
  <style>
    #nav.scrolled {
      background: color-mix(in srgb, #14532d 92%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(163, 230, 53, 0.2);
      box-shadow: 0 4px 32px rgba(20, 33, 26, 0.3);
    }
    #nav:not(.scrolled) {
      background: linear-gradient(to bottom, rgba(20, 33, 26, 0.7), transparent);
    }
    #burger.open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    #burger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    #burger.open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
  </style>

  <!-- ═══════════════════════════════════════════════
       HERO — SPEC trap #1 handled
  ══════════════════════════════════════════════════ -->
  <header class="relative min-h-screen flex items-center bg-[#14211a] overflow-hidden">
    <!-- Background image container — z-0, NOT z-10 (SPEC trap #1) -->
    <div class="absolute inset-0 z-0" id="hero-bg">
      <img
        src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1f?auto=format&fit=crop&w=1200&q=80"
        alt="Gabinet fizjoterapii"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <!-- Gradient overlay for contrast -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#14211a]/95 via-[#14211a]/70 to-[#14211a]/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#14211a]/80 via-transparent to-[#14211a]/40"></div>
    </div>

    <!-- Decorative animated elements -->
    <div class="absolute top-1/4 right-[10%] w-72 h-72 rounded-full opacity-10 bg-[#16a34a] blur-3xl animate-float z-0"></div>
    <div class="absolute bottom-1/4 right-[20%] w-48 h-48 rounded-full opacity-8 bg-[#a3e635] blur-2xl animate-float z-0" style="animation-delay: 2s;"></div>

    <!-- Diagonal stripe accent -->
    <div class="absolute inset-0 z-0 stripe-bg opacity-30 pointer-events-none"></div>

    <!-- Vertical line + dot decoration -->
    <div class="absolute left-10 top-1/2 -translate-y-1/2 hidden lg:flex flex-col items-center gap-3 z-10">
      <div class="w-px h-24 bg-gradient-to-b from-transparent to-[#16a34a]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#a3e635]" style="animation: pulse-dot 2s ease infinite;"></div>
      <div class="w-px h-24 bg-gradient-to-b from-[#16a34a] to-transparent"></div>
    </div>

    <!-- Hero content — relative z-10 (SPEC trap #1) -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 grid lg:grid-cols-2 items-center gap-12">
      <div>
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-[#16a34a]/20 border border-[#16a34a]/40 rounded-full px-4 py-1.5 mb-6">
          <div class="w-2 h-2 rounded-full bg-[#a3e635]" style="animation: pulse-dot 1.5s ease infinite;"></div>
          <span class="text-[#a3e635] text-xs font-bold tracking-widest uppercase" style="font-family: var(--font-display);">Warszawa · Mokotów</span>
        </div>

        <!-- Headline -->
        <h1
          class="text-5xl md:text-6xl xl:text-7xl font-extrabold leading-[1.05] text-white mb-6"
          style="font-family: var(--font-display);"
        >
          Wróć do<br/>
          pełnej<br/>
          <span class="text-shimmer">sprawności.</span>
        </h1>

        <p class="text-white/70 text-lg md:text-xl leading-relaxed mb-8 max-w-lg" style="font-family: var(--font-body);">
          ReVita to gabinet fizjoterapii i rehabilitacji, gdzie nowoczesne metody terapii spotykają się z indywidualnym podejściem. Twój ruch — nasza misja.
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a
            href="#rezerwacja"
            class="btn-primary inline-flex items-center gap-3 bg-[#16a34a] hover:bg-[#a3e635] text-white hover:text-[#14532d] font-bold text-base px-8 py-4 rounded-full transition-all duration-300 shadow-xl shadow-green-900/30"
            style="font-family: var(--font-display);"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Umów wizytę
          </a>
          <a
            href="#uslugi"
            class="inline-flex items-center gap-2 text-white/80 hover:text-[#a3e635] font-semibold text-base transition-colors duration-200 group"
            style="font-family: var(--font-display);"
          >
            Nasze usługi
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Quick stats -->
        <div class="flex flex-wrap gap-6 mt-10 pt-8 border-t border-white/10">
          {stats.map((s) => (
            <div class="text-center">
              <div
                class="text-3xl font-extrabold text-[#a3e635]"
                style="font-family: var(--font-display);"
                data-count={s.value}
                data-suffix={s.suffix}
              >
                0{s.suffix}
              </div>
              <div class="text-white/50 text-xs mt-0.5 font-medium">{s.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right side visual block -->
      <div class="hidden lg:flex justify-end relative">
        <div class="relative w-[420px] h-[520px]">
          <!-- Main card image -->
          <div class="absolute inset-0 rounded-3xl overflow-hidden green-glow">
            <img
              src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=800&q=80"
              alt="Fizjoterapia"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#14532d]/60 to-transparent"></div>
          </div>

          <!-- Floating badge -->
          <div class="absolute -top-5 -left-8 bg-white rounded-2xl shadow-2xl p-4 flex items-center gap-3 animate-float">
            <div class="w-12 h-12 bg-[#f3faf4] rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-[#16a34a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-sm text-[#14211a]" style="font-family: var(--font-display);">Certyfikowani</div>
              <div class="text-xs text-[#14211a]/60">Terapeuci z pasją</div>
            </div>
          </div>

          <!-- Bottom floating tag -->
          <div class="absolute -bottom-4 -right-4 bg-[#a3e635] rounded-2xl shadow-xl p-4 animate-float" style="animation-delay: 1.5s;">
            <div class="text-[#14532d] font-extrabold text-lg leading-none" style="font-family: var(--font-display);">98%</div>
            <div class="text-[#14532d]/80 text-xs font-medium mt-0.5">Skuteczność</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
      <span class="text-white/40 text-xs tracking-widest uppercase font-medium" style="font-family: var(--font-display);">Przewiń</span>
      <div class="w-5 h-8 border-2 border-white/30 rounded-full flex justify-center pt-1.5">
        <div class="w-1 h-2 bg-[#a3e635] rounded-full" style="animation: pulse-dot 1.5s ease infinite;"></div>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════
       O NAS
  ══════════════════════════════════════════════════ -->
  <section id="o-nas" class="py-24 md:py-32 bg-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-[#f3faf4] clip-path-diagonal pointer-events-none"></div>
    <div class="absolute top-20 right-10 w-64 h-64 rounded-full bg-[#dcfce7] opacity-60 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left: image mosaic -->
        <div class="reveal-left relative">
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden aspect-[3/4] bg-[#dcfce7]">
              <img
                src="https://images.unsplash.com/photo-1559757175-0eb30cd8c063?auto=format&fit=crop&w=600&q=80"
                alt="Gabinet ReVita"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="flex flex-col gap-4">
              <div class="rounded-2xl overflow-hidden flex-1 bg-[#dcfce7]">
                <img
                  src="https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?auto=format&fit=crop&w=600&q=80"
                  alt="Terapia manualna"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="bg-[#16a34a] rounded-2xl p-6 text-white">
                <div class="text-4xl font-extrabold mb-1" style="font-family: var(--font-display);">15+</div>
                <div class="text-sm font-medium text-white/80">Lat doświadczenia w rehabilitacji</div>
              </div>
            </div>
          </div>

          <!-- Accent shape -->
          <div class="absolute -bottom-6 -left-6 w-24 h-24 bg-[#a3e635] rounded-2xl -z-10 rotate-12"></div>
          <div class="absolute -top-6 -right-6 w-16 h-16 bg-[#16a34a] rounded-xl -z-10 -rotate-6 opacity-30"></div>
        </div>

        <!-- Right: content -->
        <div class="reveal-right">
          <div class="inline-flex items-center gap-2 bg-[#dcfce7] rounded-full px-4 py-1.5 mb-6">
            <div class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></div>
            <span class="text-[#14532d] text-xs font-bold tracking-widest uppercase" style="font-family: var(--font-display);">O nas</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-extrabold text-[#14211a] leading-tight mb-6" style="font-family: var(--font-display);">
            Twoje zdrowie<br/>
            <span class="text-[#16a34a]">jest naszą</span><br/>
            specjalnością
          </h2>

          <p class="text-[#14211a]/70 text-lg leading-relaxed mb-6">
            ReVita powstała z pasji do ruchu i przekonania, że każdy człowiek zasługuje na życie bez bólu i ograniczeń. Od 2009 roku pomagamy pacjentom w Warszawie odzyskać sprawność i powrócić do aktywnego życia.
          </p>
          <p class="text-[#14211a]/70 leading-relaxed mb-8">
